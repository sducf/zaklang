// ZakLang PostgreSQL schema visualization.
// SQLAlchemy models in models.py remain the application source of truth. -H


Table users {
  id uuid [pk]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(20) [not null, note: "Allowed values: viewer, member, admin. Application default: member"]
  created_at timestamptz [not null]
}

Table benchmark_runs {
  id integer [pk, increment]

  user_id uuid [not null]
  pair_id uuid
  suite_run_id integer [note: "Set for runs that a CLI suite stored with --persist"]

  task_id varchar(100) [not null, note: "References a ZakBench task ID"]
  language varchar(20) [not null, note: "Expected values: python or zak"]
  model_name varchar(255) [not null]

  temperature float
  seed integer [not null, note: "Request seed"]
  spec_version varchar(50)
  prompt_version varchar(50) [not null]
  max_attempts integer [not null]
  max_tokens integer

  status varchar(50) [not null, note: "queued, running, passed, failed, error, or timeout"]

  started_at timestamptz [not null]
  completed_at timestamptz

  indexes {
    (pair_id) [name: 'ix_benchmark_runs_pair_id']
    (suite_run_id) [name: 'ix_benchmark_runs_suite_run_id']
  }
}

Table suite_runs {
  id integer [pk, increment]

  cli_suite_run_id varchar(100) [not null, unique, note: "The CLI's id, such as dev-20261105T120000000000Z"]
  suite varchar(20) [not null, note: "Only dev today"]
  model_name varchar(255) [not null]
  seed integer [not null]
  prompt_version varchar(50) [not null]
  spec_version varchar(50)
  max_attempts integer [not null]

  status varchar(20) [not null, note: "running, completed, or failed"]

  created_at timestamptz [not null]
  finished_at timestamptz

  user_id uuid [not null, note: "The user who launched the suite from the CLI"]
}
Table attempts {
  id integer [pk, increment]

  run_id integer [not null]
  attempt_number integer [not null]

  prompt_text text [not null]
  generated_code text [not null]

  prompt_tokens integer
  completion_tokens integer
  total_tokens integer

  finish_reason varchar(100)
  latency_ms float

  created_at timestamptz [not null]

  checks {
    `attempt_number >= 1` [name: 'ck_attempts_attempt_number_positive']
  }

  indexes {
    (run_id, attempt_number) [unique, name: 'uq_attempts_run_id_attempt_number']
  }
}

Table evaluations {
  id integer [pk, increment]

  attempt_id integer [not null, unique]

  compile_success boolean
  compiler_output text
  transpiled_code text

  tests_passed integer
  tests_total integer
  correct boolean
  exec_outcome varchar(20)
  execution_ms float

  created_at timestamptz [not null]
}


// One benchmark run can contain many generation attempts. -H
Ref: attempts.run_id > benchmark_runs.id

// Each attempt can have at most one evaluation. -H
Ref: evaluations.attempt_id - attempts.id

// One user can own many benchmark runs. -H
Ref: benchmark_runs.user_id > users.id

// One suite run contains one Zak run and one Python run for each task.
Ref: benchmark_runs.suite_run_id > suite_runs.id

// One user can launch many suite runs.
Ref: suite_runs.user_id > users.id