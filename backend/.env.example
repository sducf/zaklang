# Local development database. Railway supplies DATABASE_URL in production.
DATABASE_URL=sqlite:///./zaklang_local.db

# Frontend origin allowed by CORS during local development.
FRONTEND_URL=http://localhost:5173

# Leave empty unless a local GPU service is available.
# While it is empty or the GPU is down, runs with hand-written source return 503.
GPU_API_URL=

# Replace this with a long random value outside local development.
JWT_SECRET_KEY=replace-with-a-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Usage limits (defaults shown).
# Max queued runs before new runs and pairs get 429.
RUN_QUEUE_CAP=50
# Max runs created through the API per UTC day, all users and roles combined.
DAILY_RUN_CAP=200
# Login and signup requests allowed per client IP per minute.
AUTH_RATE_LIMIT_PER_MINUTE=10
