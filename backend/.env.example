# Local development database. Railway supplies DATABASE_URL in production.
DATABASE_URL=sqlite:///./zaklang_local.db

# Frontend origin allowed by CORS during local development.
FRONTEND_URL=http://localhost:5173

# Leave empty unless a local GPU service is available.
GPU_API_URL=

# Replace this with a long random value outside local development.
JWT_SECRET_KEY=replace-with-a-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7