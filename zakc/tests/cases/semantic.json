  "test_empty_arrays_use_context_from_operators_and_builtin_signatures": [
    "a:[I]=[1]+[]",
    "a:[I]=[]+[1]",
    "a:[[I]]=[]+[[]]",
    "a:[I]=[];out(a==[])",
    "a:[I]=[];out([]==a)",
    "a:=[1]+[]",
    "a:=[]+[1]",
    "out(jn([],\",\"))"
